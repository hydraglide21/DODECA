def valider_fichier_provenance(chemin, sha_attendu):
    info={"chemin":str(chemin),"categorie":"indispensable","sha256_attendu":sha_attendu,
    "sha256_avant":None,"taille_octets":None,"statut":None,"detail":None}
    try:
        p=Path(chemin)
        if not p.exists(): info["statut"]="ABSENT_OU_ILLISIBLE"; info["detail"]="Fichier absent"; return info
        if p.is_dir(): raise IsADirectoryError("chemin est un répertoire, non un fichier")
        data=p.read_bytes()
    except Exception as e:
        info["statut"]="ABSENT_OU_ILLISIBLE"; info["detail"]=f"{type(e).__name__}: {e}"; return info
    return valider_provenance_sur_octets(data,sha_attendu,chemin,info)
def valider_provenance_sur_octets(data_octets, sha_attendu, chemin, info=None):
    """Valide à partir d'octets déjà lus une seule fois (correction 3).
    Ne relit jamais le disque. data_octets=None -> ABSENT_OU_ILLISIBLE."""
    if info is None:
        info={"chemin":str(chemin),"categorie":"indispensable","sha256_attendu":sha_attendu,
        "sha256_avant":None,"taille_octets":None,"statut":None,"detail":None}
    if data_octets is None:
        info["statut"]="ABSENT_OU_ILLISIBLE"; info["detail"]="Octets indisponibles (lecture initiale en échec)"; return info
    try:
        s=hashlib.sha256(data_octets).hexdigest(); info["sha256_avant"]=s; info["taille_octets"]=len(data_octets)
        if s==sha_attendu: info["statut"]="CONFORME"
        else: info["statut"]="NON_CONFORME"; info["detail"]="SHA-256 non conforme"
    except Exception as e:
        info["statut"]="ABSENT_OU_ILLISIBLE"; info["detail"]=f"{type(e).__name__}: {e}"
    return info
def verifier_integrite_hashes(sha_avant, sha_apres):
    return sha_avant is not None and sha_apres is not None and sha_avant==sha_apres
def verifier_integrite_fichiers(fichiers, sha_avant):
    details={}; inch=True
    for nom,ch in fichiers.items():
        p=Path(ch)
        if not p.exists():
            details[nom]={"ok":False,"sha256_apres":None,"detail":"fichier disparu entre contrôle initial et contrôle final"}; inch=False; continue
        if p.is_dir():
            details[nom]={"ok":False,"sha256_apres":None,"detail":"chemin est un répertoire, non un fichier"}; inch=False; continue
        try: sa=hashlib.sha256(p.read_bytes()).hexdigest()
        except Exception as e:
            details[nom]={"ok":False,"sha256_apres":None,"detail":f"{type(e).__name__}: {e}"}; inch=False; continue
        ok=verifier_integrite_hashes(sha_avant.get(nom),sa)
        details[nom]={"ok":bool(ok),"sha256_apres":sa,"detail":"conforme" if ok else "empreinte différente (fichier modifié)"}
        if not ok: inch=False
    return (inch,details)
def evaluer_borne(gate_demontre, ldl_stat, ldl_audit_ok):
    """V3.3.7 : validation stricte. Seuls les vrais booléens (type is bool) sont acceptés.
    "1", 1, "oui", "True" et toute valeur convertible en True sont REFUSÉES.
    Une clé obligatoire absente bloque. Une valeur indécise reste indécise.
    V3.3.7 Solution B impérative : les archives flottantes ne participent PLUS
    au gate mathématique. "archives_dans_tolerance" a été retirée de CLES_GATE.
    La comparaison des archives est une corroboration seule, jamais une preuve."""
    if not isinstance(gate_demontre, dict) or not isinstance(ldl_stat, str):
        return {"borne_statut":"NON_CONCLU","conclusion_borne":"Gate invalide (arguments non conformes).",
        "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}
    if set(gate_demontre.keys()) != set(CLES_GATE):
        manquantes=sorted(set(CLES_GATE)-set(gate_demontre.keys())); superflues=sorted(set(gate_demontre.keys())-set(CLES_GATE))
        return {"borne_statut":"NON_CONCLU",
        "conclusion_borne":f"Gate invalide : clés manquantes {manquantes}, superflues {superflues}.",
        "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}

    # Strict booléen : type(v) is bool, pas isinstance (bool est sous-classe de int).
    for k,v in gate_demontre.items():
        if type(v) is not bool:
            return {"borne_statut":"NON_CONCLU",
            "conclusion_borne":f"Gate invalide : valeur non booléenne pour la clé {k!r} (type {type(v).name}).",
            "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}
    if type(ldl_audit_ok) is not bool:
        return {"borne_statut":"NON_CONCLU","conclusion_borne":"Gate invalide : ldl_audit_ok non booléen.",
        "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}
    if ldl_stat not in ("PSD","INDEFINIE","INDECIS","NON_CALCULE"):
        return {"borne_statut":"NON_CONCLU","conclusion_borne":f"Gate invalide : ldl_stat inconnu {ldl_stat!r}.",
        "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}
    if ldl_stat in ("INDECIS","NON_CALCULE"):
        return {"borne_statut":"NON_CONCLU",
        "conclusion_borne":"Borne NON CONCLUE : LDL indécis ou non calculé, indécision conservée.",
        "conclusion_globale_M":"NON_CONCLU pour M(t).","M_psd_conclue_inconditionnelle":False}

    # Exigences mathématiques (archives exclues du gate, corroboration seule) :
    gate_sans_archives={k:v for k,v in gate_demontre.items() if k not in ("LDL_PSD",)}
    sans_ok=all(gate_sans_archives.values())
    if sans_ok and gate_demontre["LDL_PSD"] is True and ldl_stat=="PSD" and ldl_audit_ok is True:
        return {"borne_statut":"DEMONTRE",
        "conclusion_borne":"Borne mu >= 1/5 DEMONTREE exactement (gate global vérifié, archives en corroboration seule).",
        "conclusion_globale_M":"CONDITIONNELLE : M(t) >= 0 si les prémisses structurelles (M(t) = ..., alpha+4beta = 12) sont valides. V3.3.7 ne les re-démontre pas.",
        "M_psd_conclue_inconditionnelle":False}
    if sans_ok and gate_demontre["LDL_PSD"] is False and ldl_stat=="INDEFINIE" and ldl_audit_ok is True:
        return {"borne_statut":"REFUTE",
        "conclusion_borne":"Borne mu >= 1/5 REFUTEE sur l'espace de relaxation (contre-exemple exact vérifié).",
        "conclusion_globale_M":"NON_CONCLU pour M(t) : la réfutation sur l'espace de relaxation ne réfute PAS la positivité réelle de M(t). Ne pas confondre réfutation de la borne sur l'espace de relaxation, réfutation de la positivité de M(t), et absence de démonstration.",
        "M_psd_conclue_inconditionnelle":False}
    return {"borne_statut":"NON_CONCLU",
    "conclusion_borne":"Borne mu >= 1/5 NON CONCLUE (gate incomplet, indécision ou blocage).",
    "conclusion_globale_M":"NON_CONCLU pour M(t) : ne pas conclure M(t) >= 0.",
    "M_psd_conclue_inconditionnelle":False}

# ---------- LDL ----------

def schur_to_y(L,k,z_schur,perm):
    n=len(L); m=len(z_schur)
    t=[F0]*k
    for j in range(k):
        s=F0
        for i in range(m):
            if not fiszero(z_schur[i]) and not fiszero(L[k+i][j]): s=fadd(s,fmul(L[k+i][j],z_schur[i]))
        t[j]=s
    u=[F0]*k
    for j in range(k-1,-1,-1):
        s=fneg(t[j])
        for l in range(j+1,k): s=fsub(s,fmul(L[l][j],u[l]))
        u[j]=s
    y_perm=u+z_schur
    y=[F0]*n
    for idx,p in enumerate(perm): y[p]=y_perm[idx]
    return y
def verify_counterexample(D,y,attendu=None):
    if not est_carree(D): return (False,"D non carrée")
    if len(y)!=len(D): return (False,f"dimension contre-exemple {len(y)} != dim D {len(D)}")
    if all(fiszero(v) for v in y): return (False,"y nul")
    q=dense_quad(D,y); sg=f_sign_adaptive(q)
    if sg!=-1: return (False,f"q non < 0 (signe {sg}, q={f_to_str(q)})")
    if attendu is not None and q!=attendu: return (False,f"q != attendu ({f_to_str(q)} != {f_to_str(attendu)})")
    return (True,f"q={f_to_str(q)} < 0 vérifié exactement")
def ldl_with_pivot(D):
    if not est_carree(D):
        return {"statut":"INDECIS","perm":[],"L":[],"diag":[],"contre_exemple":None,"k_arret":0,"attendu":None,
        "factorisation":"aucune","verification":(False,"D non carrée"),"raison":"D non carrée."}
    n=len(D); A=[row[:] for row in D]; perm=list(range(n))
    L=[[F0]*n for _ in range(n)]
    for i in range(n): L[i][i]=F1
    diag=[]
    for k in range(n):
        cand=[i for i in range(k,n) if not fiszero(A[i][i])]
        if cand:
            piv=max(cand,key=lambda i: abs(f_to_float(A[i][i])))
            if piv!=k:
                A[k],A[piv]=A[piv],A[k]
                for row in A: row[k],row[piv]=row[piv],row[k]
                perm[k],perm[piv]=perm[piv],perm[k]
                for j in range(k): L[k][j],L[piv][j]=L[piv][j],L[k][j]
            d=A[k][k]; sg=f_sign_adaptive(d)
            if sg is None:
                return {"statut":"INDECIS","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":k,"attendu":None,
                "factorisation":"partielle (interrompue, non reconstruite)","verification":(False,"signe pivot indécis après raffinement"),"raison":"Signe du pivot LDL indécis."}
            if sg<0:
                z=[F0]*(n-k); z[0]=F1
                y=schur_to_y(L,k,z,perm)
                ok,msg=verify_counterexample(D,y,attendu=d)
                if not ok:
                    return {"statut":"INDECIS","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":k,"attendu":d,
                    "factorisation":"partielle (interrompue, non reconstruite)","verification":(False,msg),"raison":"Vérification contre-exemple (pivot négatif) échouée."}
                return {"statut":"INDEFINIE","perm":perm,"L":L,"diag":diag+[d],"contre_exemple":y,"k_arret":k,"attendu":d,
                "factorisation":"partielle (non reconstruite, audit limité)","verification":(True,msg),"raison":"Pivot négatif, contre-exemple vérifié : y^T D y = d_k < 0."}
            diag.append(d)
            for i in range(k+1,n):
                L[i][k]=fdiv(A[i][k],d) if not fiszero(A[i][k]) else F0
            for i in range(k+1,n):
                for j in range(k+1,n):
                    A[i][j]=fsub(A[i][j],fmul(fmul(L[i][k],d),L[j][k]))
            continue
        reste_nul=all(fiszero(A[i][j]) for i in range(k,n) for j in range(k,n))
        if reste_nul:
            diag.extend([F0]*(n-k))
            return {"statut":"PSD","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":n,"attendu":None,
            "factorisation":"complète","verification":(True,"reste nul"),"raison":"Reste nul, pivots >= 0."}
        found=None
        for i in range(k,n):
            for j in range(i+1,n):
                if not fiszero(A[i][j]): found=(i,j); break
            if found: break
        if found is None:
            return {"statut":"INDECIS","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":k,"attendu":None,
            "factorisation":"partielle (interrompue, non reconstruite)","verification":(False,"bloc incohérent"),"raison":"Bloc de Schur incohérent."}
        i,j=found; s=A[i][j]; sg=f_sign_adaptive(s)
        if sg is None:
            return {"statut":"INDECIS","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":k,"attendu":None,
            "factorisation":"partielle (interrompue, non reconstruite)","verification":(False,"signe hors-diagonale indécis après raffinement"),
            "raison":"Signe hors-diagonale du bloc de Schur indécis (jamais choisi arbitrairement)."}
        z=[F0]*(n-k); z[i-k]=F1; z[j-k]=fscale(F1,-sg)
        attendu=fscale(fmul(F(2),s),-sg)
        y=schur_to_y(L,k,z,perm)
        ok,msg=verify_counterexample(D,y,attendu=attendu)
        if not ok:
            return {"statut":"INDECIS","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":k,"attendu":attendu,
            "factorisation":"partielle (interrompue, non reconstruite)","verification":(False,msg),"raison":"Vérification contre-exemple (bloc Schur) échouée."}
        return {"statut":"INDEFINIE","perm":perm,"L":L,"diag":diag,"contre_exemple":y,"k_arret":k,"attendu":attendu,
        "factorisation":"partielle (non reconstruite, audit limité)","verification":(True,msg),"raison":"Bloc de Schur à diagonales nulles + hors-diagonale non nulle, contre-exemple vérifié."}
    return {"statut":"PSD","perm":perm,"L":L,"diag":diag,"contre_exemple":None,"k_arret":n,"attendu":None,
    "factorisation":"complète","verification":(True,"tous pivots >= 0"),"raison":"Tous pivots >= 0."}
def ldl_audit(D,ldl_res):
    if not est_carree(D): return (False,"audit : D non carrée.")
    n=len(D); perm=ldl_res.get("perm"); L=ldl_res.get("L"); diag=ldl_res.get("diag")
    if perm is None or L is None or diag is None: return (False,"audit : LDL incomplet (perm/L/diag manquants).")
    if len(perm)!=n: return (False,f"audit : dimension permutation {len(perm)} != dim D {n}.")
    if sorted(perm)!=list(range(n)): return (False,"audit : permutation invalide.")
    if len(L)!=n or any(len(row)!=n for row in L): return (False,f"audit : dimensions L incohérentes (attendu {n}x{n}).")
    st=ldl_res.get("statut"); k_arret=ldl_res.get("k_arret")
    if k_arret is None: return (False,"audit : k_arret manquant.")
    if st=="PSD":
        if ldl_res.get("factorisation")!="complète": return (False,"audit PSD : factorisation annoncée non complète.")
        if len(diag)!=n: return (False,f"audit PSD : dimension pivots {len(diag)} != dim D {n}.")
        for i in range(n):
            if L[i][i]!=F1: return (False,f"audit PSD : L non unitaire en diagonale (i={i}).")
            for j in range(i+1,n):
                if not fiszero(L[i][j]): return (False,f"audit PSD : L non triangulaire inférieure (i={i}, j={j}).")
        Dp=[[D[perm[i]][perm[j]] for j in range(n)] for i in range(n)]
        M=[[fmul(L[i][j],diag[j]) for j in range(n)] for i in range(n)]
        R=[[F0]*n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                s=F0
                for k in range(n): s=fadd(s,fmul(M[i][k],L[j][k]))
                R[i][j]=s
        if not dense_eq(R,Dp): return (False,"audit PSD : reconstruction L Diag L^T != P D P^T.")
        for d in diag:
            sg=f_sign_adaptive(d)
            if sg is None: return (False,"audit PSD : signe d'un pivot indécis.")
            if sg<0: return (False,"audit PSD : pivot négatif.")
        return (True,"audit LDL PSD : D carrée, dimensions cohérentes, L unitaire, reconstruction complète exacte, pivots >= 0.")
    if st=="INDEFINIE":
        if "non reconstruite" not in str(ldl_res.get("factorisation","")): return (False,"audit INDEFINIE : factorisation annoncée comme reconstruite, refusé (audit limité).")
        y=ldl_res.get("contre_exemple")
        if y is None: return (False,"audit INDEFINIE : sans contre-exemple.")
        if len(y)!=n: return (False,f"audit INDEFINIE : dimension contre-exemple {len(y)} != dim D {n}.")
        if len(diag) not in (k_arret,k_arret+1): return (False,f"audit INDEFINIE : dimension pivots {len(diag)} incohérente avec k_arret {k_arret}.")
        for j in range(min(k_arret,n)):
            if L[j][j]!=F1: return (False,f"audit INDEFINIE : L non unitaire en diagonale partielle (j={j}).")
        attendu=ldl_res.get("attendu")
        ok,msg=verify_counterexample(D,y,attendu=attendu)
        if not ok: return (False,f"audit INDEFINIE : certificat non vérifié : {msg}")
        return (True,f"audit LDL INDEFINIE (LIMITÉ) : D carrée, dimensions cohérentes, structure minimale, certificat décisif {msg}. Factorisation partielle NON reconstruite.")
    if st=="INDECIS":
        return (False,"audit LDL INDECIS : dimensions vérifiées, indécision conservée, aucune factorisation complète prétendue.")
    return (False,f"audit : statut LDL inconnu : {st}")

# ---------- Borne d'arrondi des archives (correction 2) ----------

def calculer_borne_arrondi(R_exact, K_exact, Ra, Ka):
    """Calcule Nmax et S_abs_max sur la structure réellement reconstruite de R,
    et établit une borne d'arrondi pour K0 = R^T R.
    Hypothèses vérifiées explicitement (H1..H5). Si une hypothèse échoue,
    la fonction ne retourne PAS une « borne théorique » : borne_K=None,
    hypotheses_verifiees=False, estimation_non_verifiee documentée.
    Modèle : flottants binaire64, u = 2**-53.
    - conversion exact -> flottant : |fl(x)-x| <= u|x| ;
    - multiplication flottante : |fl(ab)-ab| <= u|a*b| ;
    - sommation de N termes : |fl(sum)-sum| <= (N-1)*u*sum|termes| (borne valable
      pour tout ordre de sommation, donc sans hypothèse sur l'ordre de l'archive) ;
    - chaque produit utilise deux R convertis : erreur <= 3u|terme| (2 conversions + mult).
    - les annulations sont prises en compte : la borne utilise sum|termes|, non |sum|,
      donc une annulation ne peut que réduire l'erreur réelle sous la borne.
    Borne K0 : (Nmax+3)*u*S_abs_max + u*echelle_K (conversion finale de K exact).
    Borne R : 2*u*echelle_R (conversion + stockage)."""
    res={"hypotheses":{},"hypotheses_verifiees":False,"Nmax":None,"S_abs_max":None,
    "echelle_R":None,"echelle_K":None,"borne_R":None,"borne_K":None,
    "estimation_non_verifiee":None,"tolérance_validee":False,"detail":None}
    try:
        h1=isinstance(Ra,np.ndarray) and isinstance(Ka,np.ndarray) and Ra.dtype.kind=="f" and Ka.dtype.kind=="f" and Ra.dtype.itemsize==8 and Ka.dtype.itemsize==8
        res["hypotheses"]["H1_archives_float64"]=bool(h1)
        h2=bool(isinstance(Ra,np.ndarray) and isinstance(Ka,np.ndarray) and Ra.shape==(60,60) and Ka.shape==(60,60))
        res["hypotheses"]["H2_formes_60x60"]=bool(h2)
        h3=bool(np.isfinite(Ra).all() and np.isfinite(Ka).all()) if (isinstance(Ra,np.ndarray) and isinstance(Ka,np.ndarray)) else False
        res["hypotheses"]["H3_archives_finies"]=bool(h3)

        # Échelles à partir des valeurs exactes reconstruites (finies vérifiées par l'appelant).
        Rf_vals=[f_to_float(v) for v in R_exact.values()] if R_exact else [0.0]
        Kf_vals=[f_to_float(v) for v in K_exact.values()] if K_exact else [0.0]
        h4=all(math.isfinite(x) for x in Rf_vals) and all(math.isfinite(x) for x in Kf_vals)
        res["hypotheses"]["H4_reconstructions_finies"]=bool(h4)
        echelle_R=float(max(abs(x) for x in Rf_vals)) if Rf_vals else 0.0
        echelle_K=float(max(abs(x) for x in Kf_vals)) if Kf_vals else 0.0
        res["echelle_R"]=echelle_R; res["echelle_K"]=echelle_K

        # Nmax et S_abs_max sur la structure réelle de R.
        Rf_dict={}
        for (r,c),v in R_exact.items(): Rf_dict[(r,c)]=f_to_float(v)
        Nmax=0; S_abs_max=0.0; coeffs_avec_termes=0
        for i in range(60):
            for j in range(60):
                s_abs=0.0; n=0
                for b in range(60):
                    a=Rf_dict.get((b,i)); c=Rf_dict.get((b,j))
                    if a is not None and c is not None:
                        n+=1; s_abs+=abs(a*c)
                if n>0: coeffs_avec_termes+=1
                if n>Nmax: Nmax=n
                if s_abs>S_abs_max: S_abs_max=s_abs
        res["Nmax"]=int(Nmax); res["S_abs_max"]=float(S_abs_max); res["coeffs_K0_avec_termes"]=int(coeffs_avec_termes)
        h5=(Nmax>0 and math.isfinite(S_abs_max) and math.isfinite(echelle_R) and math.isfinite(echelle_K))
        res["hypotheses"]["H5_structure_R_non_vide_finie"]=bool(h5)
        if not all(res["hypotheses"].values()):
            res["detail"]="Hypothèses H1..H5 non toutes vérifiées : aucune borne théorique affirmée."
            res["estimation_non_verifiee"]="Estimation indicative (non validée) : (Nmax+3)*u*S_abs_max + u*echelle_K, sans valeur de preuve."
            return res
        borne_R=2.0*U_ARRONDI*echelle_R
        borne_K=(Nmax+3)*U_ARRONDI*S_abs_max+U_ARRONDI*echelle_K
        res["borne_R"]=float(borne_R); res["borne_K"]=float(borne_K); res["hypotheses_verifiees"]=True
        res["tolérance_validee"]=bool(borne_K<TOL_ARCHIVES)
        res["ratio_tolerance_sur_borne"]=float(TOL_ARCHIVES/borne_K) if borne_K>0 else float("inf")
        res["detail"]=(f"Borne K0 = (Nmax+3)*u*S_abs_max + u*echelle_K avec Nmax={Nmax}, S_abs_max={S_abs_max:.3e}, "
        f"echelle_K={echelle_K:.3f}, u={U_ARRONDI:.2e} -> borne_K={borne_K:.2e}. "
        f"Tolérance {TOL_ARCHIVES:.0e} validée : {res['tolérance_validee']} (ratio {res['ratio_tolerance_sur_borne']:.1f}x). "
        f"Annulations prises en compte via sum|termes|. Comparaison = corroboration, jamais preuve exacte.")
        return res
    except Exception as e:
        res["detail"]=f"Calcul de borne impossible : {type(e).name}: {e}"
        res["estimation_non_verifiee"]="Aucune borne affirmée (calcul en échec)."
        return res
def comparer_archives(R_exact, K_exact, Ra, Ka):
    """V3.3.7 Solution B : cette comparaison est une CORROBORATION NUMÉRIQUE SEULE.
    Elle ne décide jamais de la validité mathématique de la borne. La preuve
    repose exclusivement sur la reconstruction exacte de R/K0, les projecteurs
    spectraux exacts et le quotient exact. La tolérance 1e-12 est empirique."""
    msgs=[]; comp={}
    def check_array(nom,arr):
        if not isinstance(arr,np.ndarray): return (False,f"Archive {nom} : type inattendu {type(arr).name}, attendu ndarray.")
        if arr.ndim!=2 or arr.shape!=(60,60): return (False,f"Archive {nom} : forme {arr.shape}, attendue (60,60).")
        if arr.dtype.kind not in ("f","i","u"): return (False,f"Archive {nom} : dtype {arr.dtype}, attendu flottant/entier.")
        try:
            if not bool(np.isfinite(arr).all()): return (False,f"Archive {nom} : contient NaN ou infini.")
        except Exception as e: return (False,f"Archive {nom} : contrôle finitude impossible ({e}).")
        return (True,"")
    ok=True
    for nom,arr in [("R",Ra),("K0",Ka)]:
        good,msg=check_array(nom,arr)
        if not good: msgs.append(msg); ok=False
    if not ok: return (False,comp,msgs)
    Rf=np.zeros((60,60)); Kf=np.zeros((60,60))
    try:
        for (r,c),v in R_exact.items(): Rf[r,c]=f_to_float(v)
        for (r,c),v in K_exact.items(): Kf[r,c]=f_to_float(v)
    except Exception as e:
        return (False,comp,[f"Conversion exacte -> flottant impossible : {e}"])
    for nom,exact in [("R",Rf),("K0",Kf)]:
        if not bool(np.isfinite(exact).all()): msgs.append(f"Reconstruction {nom} : contient NaN ou infini."); ok=False
    if not ok: return (False,comp,msgs)

    # Borne d'arrondi quantitative, hypothèses vérifiées (correction 2).
    borne_info=calculer_borne_arrondi(R_exact,K_exact,Ra,Ka)
    comp["borne_arrondi"]=borne_info
    if not borne_info.get("hypotheses_verifiees"):
        msgs.append("Borne d'arrondi non validée : hypothèses H1..H5 non vérifiées. Aucune borne théorique affirmée ; certification bloquée.")
        return (False,comp,msgs)
    if not borne_info.get("tolérance_validee"):
        msgs.append(f"Tolérance {TOL_ARCHIVES:.0e} non validée par la borne quantitative : borne_K={borne_info.get('borne_K'):.2e} >= tolérance. Certification bloquée.")
        return (False,comp,msgs)

    # Borne R utilisée pour le contrôle de R, borne K pour K0.
    comp["justification_tolerance"]=borne_info.get("detail")
    comp["borne_theorique_R"]=borne_info.get("borne_R"); comp["borne_theorique_K0"]=borne_info.get("borne_K")
    for nom,exact,arch,borne in [("R",Rf,Ra.astype(float),borne_info.get("borne_R")),("K0",Kf,Ka.astype(float),borne_info.get("borne_K"))]:
        try: diff=np.abs(exact-arch)
        except Exception as e:
            msgs.append(f"Archive {nom} : différence impossible ({e})."); ok=False; continue
        if not bool(np.isfinite(diff).all()):
            msgs.append(f"Archive {nom} : différence non finie (NaN/inf) -> rejet."); ok=False; continue
        mx=float(diff.max()); mn=float(diff.mean()); n_dep=int((diff>TOL_ARCHIVES).sum())
        comp[nom]={"max_abs_diff":mx,"mean_abs_diff":mn,"n_depasse_tolerance":n_dep,
        "tolerance":TOL_ARCHIVES,"borne_appliquee":borne,
        "regle":"bloque si max > tolérance ou non fini ; jamais d'égalité flottante bit à bit ; comparaison = corroboration, jamais preuve exacte."}
        if mx>TOL_ARCHIVES: msgs.append(f"Archive {nom} : max diff {mx:.2e} > tolérance {TOL_ARCHIVES:.0e} -> certification bloquée."); ok=False
        if borne is not None and mx>borne:
            # Un écart supérieur à la borne mais inférieur à la tolérance reste accepté
            # (tolérance = marge), mais il est signalé comme dépassement de borne.
            comp[nom]["depassement_borne"]=True
    return (ok,comp,msgs)

def verifier_verrou_projecteurs(p2, orth, somme_I, kpa, traces_entieres, somme_traces):
    """Verrou V3.3.7 : les 6 conditions doivent être simultanément True et booléennes.
    Un échec ou une indécision bloque. Une section exécutée n'est pas une section validée."""
    vals={"idempotence":p2,"orthogonalite":orth,"somme_I":somme_I,"spectrale_KPa":kpa,
    "traces_entieres":traces_entieres,"somme_traces":somme_traces}
    for k,v in vals.items():
        if type(v) is not bool: return False
    return all(vals.values())

def _est_entier_strict(x):
    """Rejette les booléens utilisés comme entiers (type is int, pas bool)."""
    return type(x) is int

def valider_entrees(V, C, bars, rot, Ra, Ka):
    """Validation renforcée avant tout appel géométrique (V3.3.7 §6).
    Retourne (ok, motifs). Booléens rejetés comme entiers."""
    motifs=[]
    if type(V) is not list or len(V)!=20: motifs.append("V : type ou nombre de sommets != 20")
    else:
        for vi,v in enumerate(V):
            if type(v) is not list or len(v)!=3: motifs.append(f"V[{vi}] : pas une liste de 3 coordonnées"); break
            for k,coord in enumerate(v):
                if type(coord) is not tuple or len(coord)!=2: motifs.append(f"V[{vi}][{k}] : coordonnée non (Fraction,Fraction)"); break
                if not all(type(x) is Fraction for x in coord): motifs.append(f"V[{vi}][{k}] : coordonnée non Fraction"); break
    if type(C) is not list or len(C)!=5: motifs.append("C : type ou nombre de cubes != 5")
    else:
        for ci,c in enumerate(C):
            if type(c) is not set or len(c)!=8: motifs.append(f"C[{ci}] : pas un ensemble de 8 sommets"); continue
            for v in c:
                if not _est_entier_strict(v) or not (0<=v<20): motifs.append(f"C[{ci}] : indice {v!r} hors bornes ou non entier strict"); break
    if type(bars) is not list or len(bars)!=60: motifs.append("bars : type ou nombre != 60")
    else:
        vus=set()
        for bi,b in enumerate(bars):
            if type(b) is not tuple or len(b)!=3: motifs.append(f"bars[{bi}] : pas un triplet"); break
            x,y,cu=b
            if not _est_entier_strict(x) or not _est_entier_strict(y) or not _est_entier_strict(cu): motifs.append(f"bars[{bi}] : composante booléenne ou non entière"); break
            if not (0<=x<20 and 0<=y<20 and 1<=cu<=5): motifs.append(f"bars[{bi}] : indices hors bornes"); break
            if x==y: motifs.append(f"bars[{bi}] : extrémités identiques"); break
            cle=(frozenset((x,y)),cu)
            if cle in vus: motifs.append(f"bars[{bi}] : doublon interdit (paire, cube)"); break
            vus.add(cle)
    if type(rot) is not list or len(rot)==0: motifs.append("rotations : type ou structure invalide (liste vide)")
    else:
        for ri,r in enumerate(rot):
            if type(r) is not dict or "matrice" not in r and "rotation" not in r and len(r)==0: motifs.append(f"rotations[{ri}] : entrée vide ou non dict"); break
    for nom,arr in [("R_archive",Ra),("K0_archive",Ka)]:
        if not isinstance(arr, np.ndarray): motifs.append(f"{nom} : pas un ndarray")
        elif arr.ndim!=2 or arr.shape!=(60,60): motifs.append(f"{nom} : forme {arr.shape} != (60,60)")
        elif arr.dtype.kind not in ("f","i","u"): motifs.append(f"{nom} : dtype {arr.dtype} non numérique")
        else:
            try:
                if arr.dtype.kind=="f" and not bool(np.isfinite(arr).all()): motifs.append(f"{nom} : contient NaN ou infini")
            except Exception as e: motifs.append(f"{nom} : contrôle finitude impossible ({e})")
    return (len(motifs)==0, motifs)

def verifier_rapport_sans_nan(obj, chemin="racine"):
    """Recherche récursive de NaN / Infinity dans un rapport. Retourne (ok, motifs)."""
    import math as _math
    motifs=[]
    def rec(o, ch):
        if isinstance(o, float):
            if _math.isnan(o): motifs.append(f"{ch} : NaN")
            elif _math.isinf(o): motifs.append(f"{ch} : Infinity")
        elif isinstance(o, dict):
            for k,v in o.items(): rec(v, f"{ch}.{k}")
        elif isinstance(o, (list, tuple)):
            for i,v in enumerate(o): rec(v, f"{ch}[{i}]")
    rec(obj, chemin)
    return (len(motifs)==0, motifs)

def statut_corroboration(ok, exception=False, calcule=True):
    if not calcule: return "CORROBORATION_NON_CALCULEE"
    if exception: return "CORROBORATION_INDISPONIBLE"
    return "CORROBORATION_CONFORME" if ok else "CORROBORATION_ECART"

def verifier_integrite_fichier_chemin(chemin, sha_attendu=None, taille_attendue=None):
    from pathlib import Path as _P
    import hashlib as _h
    try:
        data=_P(chemin).read_bytes()
    except Exception as e:
        return {"statut":"ABSENT_OU_ILLISIBLE","detail":f"{type(e).name}: {e}","sha256":None,"taille_octets":None}
    sha=_h.sha256(data).hexdigest()
    if sha_attendu is not None and sha!=sha_attendu:
        return {"statut":"MODIFIE","detail":"SHA-256 différent de l'attendu","sha256":sha,"taille_octets":len(data)}
    if taille_attendue is not None and len(data)!=taille_attendue:
        return {"statut":"MODIFIE","detail":"Taille différente de l'attendue","sha256":sha,"taille_octets":len(data)}
    if sha_attendu is None and taille_attendue is None:
        return {"statut":"CONFORME (lecture seule, sans référence)","detail":None,"sha256":sha,"taille_octets":len(data)}
    return {"statut":"CONFORME","detail":None,"sha256":sha,"taille_octets":len(data)}

def verifier_exports_partie_a():
    """Vérifie que l'import expose réellement toutes les fonctions nécessaires.
    Ne suppose pas que "import *" importe les noms privés."""
    import sys as _sys
    mod=_sys.modules.get(__name__)
    manquants=[n for n in __all__ if not hasattr(mod, n)]
    return (len(manquants)==0, manquants)

