# ---------- Corps Q(sqrt5, sqrt6) ----------

def F(a=0,b=0,c=0,d=0): return (Fraction(a),Fraction(b),Fraction(c),Fraction(d))
F0 = F(); F1 = F(1)
def fadd(x,y): return (x[0]+y[0],x[1]+y[1],x[2]+y[2],x[3]+y[3])
def fneg(x): return (-x[0],-x[1],-x[2],-x[3])
def fsub(x,y): return fadd(x,fneg(y))
def fmul(x,y):
    a,b,c,d = x; e,f,g,h = y
    return (a*e+5*b*f+6*c*g+30*d*h, a*f+b*e+6*c*h+6*d*g,
            a*g+c*e+5*b*h+5*d*f, a*h+d*e+b*g+c*f)
def fscale(x,q): q=Fraction(q); return (x[0]*q,x[1]*q,x[2]*q,x[3]*q)
def fiszero(x): return x==(Fraction(0),)*4
def solve_lin(M,rhs):
    n=len(M); A=[row[:] + [rhs[i]] for i,row in enumerate(M)]
    for col in range(n):
        piv=None
        for r in range(col,n):
            if A[r][col]!=0: piv=r; break
        if piv is None: raise ZeroDivisionError("matrice singulière")
        A[col],A[piv]=A[piv],A[col]
        pv=A[col][col]; A[col]=[v/pv for v in A[col]]
        for r in range(n):
            if r!=col and A[r][col]!=0:
                f=A[r][col]; A[r]=[a-f*b for a,b in zip(A[r],A[col])]
    return [A[i][n] for i in range(n)]
def finv(x):
    if fiszero(x): raise ZeroDivisionError("inverse de 0 dans Q(sqrt5,sqrt6)")
    cols=[]
    for j in range(4):
        e=[Fraction(0)]*4; e[j]=Fraction(1); cols.append(fmul(x,tuple(e)))
    M=[[cols[j][i] for j in range(4)] for i in range(4)]
    return tuple(solve_lin(M,[Fraction(1),Fraction(0),Fraction(0),Fraction(0)]))
def fdiv(x,y): return fmul(x,finv(y))
def f_to_float(x): return float(x[0]+x[1]*5**0.5+x[2]*6**0.5+x[3]*30**0.5)
def f_to_str(x):
    parts=[]
    for v,n in zip(x,["","sqrt5","sqrt6","sqrt30"]):
        if v!=0: parts.append(f"{v}*{n}" if n else str(v))
    return " + ".join(parts) if parts else "0"
def sqrt_bounds(p,den):
    n=math.isqrt(p*den*den); return (Fraction(n,den), Fraction(n+1,den))
def f_interval_den(x,den):
    lo=Fraction(0); hi=Fraction(0)
    for coeff,p in [(x[1],5),(x[2],6),(x[3],30)]:
        lo_p,hi_p=sqrt_bounds(p,den)
        if coeff>=0: lo+=coeff*lo_p; hi+=coeff*hi_p
        else: lo+=coeff*hi_p; hi+=coeff*lo_p
    lo+=x[0]; hi+=x[0]; return (lo,hi)
def f_sign_adaptive(x,dens=(10**12,10**18,10**24,10**36,10**60,10**100)):
    if fiszero(x): return 0
    for den in dens:
        lo,hi=f_interval_den(x,den)
        if lo>0: return 1
        if hi<0: return -1
    return None
def f_is_pos(x): return f_sign_adaptive(x)==1
def parse_csv_expr(s):
    a=b=Fraction(0)
    for t in re.findall(r"[+-]?[^+-]+", s.replace(" ","")):
        sg=1
        if t[0]=="+": t=t[1:]
        elif t[0]=="-": sg=-1; t=t[1:]
        if "sqrt(5)" in t:
            pre,post=t.split("sqrt(5)"); c=Fraction(pre.rstrip("*")) if pre.rstrip("*") else Fraction(1)
            if post.startswith("/"): c/=Fraction(post[1:])
            elif post.startswith("*"): c*=Fraction(post[1:])
            elif post!="": raise ValueError(s)
            b+=sg*c
        else: a+=sg*Fraction(t)
    return (a,b)
def q5_to_F(pair): return (Fraction(pair[0]),Fraction(pair[1]),Fraction(0),Fraction(0))
def q5_add(x,y): return (x[0]+y[0], x[1]+y[1])
def q5_sub(x,y): return (x[0]-y[0], x[1]-y[1])
def q5_mul(x,y): return (x[0]*y[0]+5*x[1]*y[1], x[0]*y[1]+x[1]*y[0])
def q5_scale_int(x,k): return (x[0]*k, x[1]*k)
def q5_to_str(x):
    if x[1]==0: return str(x[0])
    if x[0]==0: return f"{x[1]}*sqrt5"
    return f"{x[0]} + {x[1]}*sqrt5"
def q5_is_pos(x): return f_sign_adaptive(q5_to_F(x))==1
def dist_carree_q5(V,a,b):
    s=(Fraction(0),Fraction(0))
    for k in range(3):
        dx=q5_sub(V[b][k],V[a][k]); s=q5_add(s,q5_mul(dx,dx))
    return s

# ---------- Matrices + symétrie ----------

def sp_clean(d): return {k:v for k,v in d.items() if not fiszero(v)}
def sp_mul(A,B):
    brow={}
    for (r,c),v in B.items(): brow.setdefault(r,[]).append((c,v))
    C={}
    for (r,m),av in A.items():
        for c,bv in brow.get(m,[]):
            C[(r,c)]=fadd(C.get((r,c),F0),fmul(av,bv))
    return sp_clean(C)
def sp_scale(A,s): return sp_clean({k:fmul(v,s) for k,v in A.items()})
def sp_matvec(A,v):
    o=[F0]*60
    for (r,c),x in A.items(): o[r]=fadd(o[r],fmul(x,v[c]))
    return o
def sp_trace(A):
    s=F0
    for i in range(60): s=fadd(s,A.get((i,i),F0))
    return s
def sp_eq(A,B): return sp_clean(A)==sp_clean(B)
def dense_matvec(M,v):
    out=[]
    for i in range(len(M)):
        s=F0
        for j in range(len(v)): s=fadd(s,fmul(M[i][j],v[j]))
        out.append(s)
    return out
def dense_quad(D,y):
    Dy=dense_matvec(D,y); s=F0
    for i in range(len(y)): s=fadd(s,fmul(y[i],Dy[i]))
    return s
def dense_eq(A,B):
    return len(A)==len(B) and all(len(A[i])==len(B[i]) for i in range(len(A))) and all(A[i][j]==B[i][j] for i in range(len(A)) for j in range(len(A[i])))
def est_carree(D):
    return isinstance(D,list) and len(D)>0 and all(isinstance(row,list) and len(row)==len(D) for row in D)
def verifier_symetrie(M):
    """Exact : M carrée et M[i][j] == M[j][i] pour tous i,j. Non carrée -> False."""
    if not est_carree(M): return False
    n=len(M)
    for i in range(n):
        for j in range(n):
            if M[i][j]!=M[j][i]: return False
    return True

