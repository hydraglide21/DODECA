        for (a,b,cu) in bars:
            if cu==c+1: ends.add(a); ends.add(b)
        if ends!=set(C[c]): corr=False
    r["correspondance_numerotation"]=corr
    r["bars_1_eq_C0"]=corr and all(a in C[0] and b in C[0] for (a,b,cu) in bars if cu==1)
    return r
def valider_aretes_geometriques(V,C,bars):
    bool_keys=["aretes_longueurs_uniformes","aretes_classification_distances","aretes_biparti",
    "aretes_sans_triangle","aretes_diametre_3","aretes_comptes_graphes","aretes_geometriques_completes"]
    def echec(motif):
        return ({k:False for k in bool_keys},{"motif":motif,"longueur_carree":None,"details_par_cube":[]})
    try:
        if len(V)!=20 or len(C)!=5 or len(bars)!=60: return echec("dimensions V/C/bars non conformes")
        if any(len(C[c])!=8 for c in range(5)): return echec("un cube n'a pas 8 sommets")
        a0,b0,_=bars[0]; edge_sq=dist_carree_q5(V,a0,b0)
        if edge_sq==(Fraction(0),Fraction(0)): return echec("longueur carrée de référence nulle")
        if not q5_is_pos(edge_sq): return echec("longueur carrée de référence non > 0")
        longueurs_uniformes=True
        for (a,b,cu) in bars:
            if dist_carree_q5(V,a,b)!=edge_sq: longueurs_uniformes=False; break
        if not longueurs_uniformes: return echec("longueurs des barres non uniformes en Q(sqrt5)")
        deux=q5_scale_int(edge_sq,2); trois=q5_scale_int(edge_sq,3)
        details=[]; class_ok=True; bip_ok=True; tri_ok=True; diam_ok=True; comptes_ok=True
        for c in range(5):
            verts=list(C[c]); bars_c={frozenset((a,b)) for (a,b,cu) in bars if cu==c+1}
            if len(bars_c)!=12: class_ok=False; details.append({"cube":c+1,"motif":"pas 12 barres distinctes"}); continue
            n_edge=0; n_face=0; n_space=0; n_inattendu=0; edge_pairs=set()
            for i in range(len(verts)):
                for j in range(i+1,len(verts)):
                    d=dist_carree_q5(V,verts[i],verts[j]); paire=frozenset((verts[i],verts[j]))
                    if d==edge_sq: n_edge+=1; edge_pairs.add(paire)
                    elif d==deux: n_face+=1
                    elif d==trois: n_space+=1
                    else: n_inattendu+=1
            if n_inattendu!=0 or n_edge!=12 or n_face!=12 or n_space!=4: class_ok=False
            if bars_c!=edge_pairs: class_ok=False
            adj={v:set() for v in verts}
            for paire in bars_c:
                x,y=tuple(paire); adj[x].add(y); adj[y].add(x)
            couleur={}; bip=True
            for depart in verts:
                if depart in couleur: continue
                couleur[depart]=0; pile=[depart]
                while pile and bip:
                    u=pile.pop()
                    for w in adj[u]:
                        if w not in couleur: couleur[w]=1-couleur[u]; pile.append(w)
                        elif couleur[w]==couleur[u]: bip=False; break
            if not bip: bip_ok=False
            tri=False
            for i in range(len(verts)):
                for j in range(i+1,len(verts)):
                    for k in range(j+1,len(verts)):
                        if frozenset((verts[i],verts[j])) in bars_c and frozenset((verts[i],verts[k])) in bars_c and frozenset((verts[j],verts[k])) in bars_c: tri=True
            if tri: tri_ok=False
            dists={}
            for s in verts:
                dist={s:0}; pile=[s]
                while pile:
                    u=pile.pop(0)
                    for w in adj[u]:
                        if w not in dist: dist[w]=dist[u]+1; pile.append(w)
                for t in verts:
                    if t>s: dists[(s,t)]=dist.get(t,None)
            if any(v is None for v in dists.values()): diam_ok=False; comptes_ok=False
            else:
                if max(dists.values())!=3: diam_ok=False
                c1=sum(1 for v in dists.values() if v==1); c2=sum(1 for v in dists.values() if v==2); c3=sum(1 for v in dists.values() if v==3)
                if not (c1==12 and c2==12 and c3==4): comptes_ok=False
            details.append({"cube":c+1,"n_arete_dist":n_edge,"n_face_dist":n_face,"n_espace_dist":n_space,
            "n_inattendu":n_inattendu,"barres_eq_aretes_geometriques":(bars_c==edge_pairs),
            "biparti":bip,"sans_triangle":(not tri),
            "diametre":(max(dists.values()) if dists and all(v is not None for v in dists.values()) else None)})
        bool_dict={"aretes_longueurs_uniformes":bool(longueurs_uniformes),
        "aretes_classification_distances":bool(class_ok),"aretes_biparti":bool(bip_ok),
        "aretes_sans_triangle":bool(tri_ok),"aretes_diametre_3":bool(diam_ok),
        "aretes_comptes_graphes":bool(comptes_ok),
        "aretes_geometriques_completes":bool(longueurs_uniformes and class_ok and bip_ok and tri_ok and diam_ok and comptes_ok)}
        details_dict={"longueur_carree":q5_to_str(edge_sq),"details_par_cube":details,
        "motif":None if bool_dict["aretes_geometriques_completes"] else "convention d'arêtes non établie pour au moins un cube"}
        return (bool_dict,details_dict)
    except Exception as e:
        return ({k:False for k in bool_keys},{"motif":f"{type(e).name}: {e}","longueur_carree":None,"details_par_cube":[]})
def accessible_nonempty(idx,vs):
    if idx is None or len(idx)==0: return (False,"idx vide : aucun mode positif accessible.")
    for a in idx:
        if a is None or a<0 or a>=len(vs): return (False,f"indice spectral invalide : {a}.")
        if all(fiszero(x) for x in vs[a]): return (False,f"mode retenu nul : a={a}.")
        n2=F0
        for _i in range(len(vs[a])): n2=fadd(n2,fmul(vs[a][_i],vs[a][_i]))
        if f_sign_adaptive(n2)!=1: return (False,f"norme du mode retenu non > 0 : a={a}.")
    return (True,"espace accessible non vide, modes non nuls, normes > 0.")
