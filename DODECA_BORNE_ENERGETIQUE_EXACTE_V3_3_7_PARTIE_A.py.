def valider_geometrie(V,C,bars):
    r={}
    r["n_sommets_20"]=len(V)==20
    r["sommets_distincts"]=len({tuple(v) for v in V})==20
    r["n_cubes_5"]=len(C)==5
    r["cubes_8_distincts"]=all(len(C[c])==8 and len(set(C[c]))==8 for c in range(5))
    r["cubes_indices_valides"]=all(all(isinstance(v,int) and 0<=v<20 for v in C[c]) for c in range(5))
    r["cubes_distincts"]=len({frozenset(C[c]) for c in range(5)})==5
    r["union_cubes_20"]=set().union(*[set(C[c]) for c in range(5)])==set(range(20)) if len(C)==5 else False
    if len(C)==5:
        cnt=[0]*20
        for c in range(5):
            for v in C[c]: cnt[v]+=1
        r["chaque_sommet_2_cubes"]=all(x==2 for x in cnt)
    else: r["chaque_sommet_2_cubes"]=False
    r["n_barres_60"]=len(bars)==60
    r["endpoints_distincts_valides"]=all(isinstance(a,int) and isinstance(b,int) and 0<=a<20 and 0<=b<20 and a!=b and 1<=cu<=5 for (a,b,cu) in bars)
    r["appartenance_cube_porteur"]=all(a in C[cu-1] and b in C[cu-1] for (a,b,cu) in bars) if r["n_cubes_5"] else False
    r["barres_par_cube_12"]=all(sum(1 for (a,b,cu) in bars if cu==c+1)==12 for c in range(5))
    r["sans_doublon_paire_cube"]=len({(frozenset((a,b)),cu) for (a,b,cu) in bars})==len(bars)
    deg_ok=True
    for c in range(5):
        for v in C[c]:
            if sum(1 for (a,b,cu) in bars if cu==c+1 and (a==v or b==v))!=3: deg_ok=False
    r["degre_3_par_cube"]=deg_ok
    corr=True
    for c in range(5):
